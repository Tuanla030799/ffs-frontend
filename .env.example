# Docker/VM (Nginx proxy /api và /files sang BE): giữ đường dẫn tương đối /api.
# Cloudflare Workers (không có proxy): dùng URL HTTPS đầy đủ của BE, gồm API root,
# ví dụ https://api.thepocketshoes.store/api
NUXT_PUBLIC_API_BASE_URL=/api
NUXT_PUBLIC_API_TIMEOUT=15000
# Origin phục vụ file/ảnh tương đối (/files/...). Để trống: dùng đường dẫn tương đối như cũ,
# hoặc origin của NUXT_PUBLIC_API_BASE_URL khi API là URL tuyệt đối.
# Không thêm /files vào cuối nếu BE trả về đường dẫn dạng /files/...
NUXT_PUBLIC_FILE_BASE_URL=
# Domain FE public, dùng cho canonical, og:image, robots.txt, sitemap.xml.
NUXT_PUBLIC_SITE_URL=http://thepocketshoes.store
FRONTEND_HTTP_PORT=80
